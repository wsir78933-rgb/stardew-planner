{
  "name": "stardew-planner",
  "account_id": "c75d13cb32903c8f0ec7948f6c91c9ed",
  "main": "workers/planner-worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "STATIC_ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "stardewvalleyplanner.art/api/contact*",
      "custom_domain": false
    },
    {
      "pattern": "stardewvalleyplanner.art/api/feedback*",
      "custom_domain": false
    },
    {
      "pattern": "stardewvalleyplanner.art",
      "custom_domain": true
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": [
        "contact@stardewvalleyplanner.art"
      ],
      "destination_address": "wsir78933@gmail.com"
    }
  ],
  "vars": {
    "CONTACT_ALLOWED_ORIGIN": "https://stardewvalleyplanner.art",
    "CONTACT_EXPECTED_TURNSTILE_HOSTNAME": "stardewvalleyplanner.art",
    "CONTACT_TURNSTILE_ACTION": "turnstile-spin-v2"
  }
}
