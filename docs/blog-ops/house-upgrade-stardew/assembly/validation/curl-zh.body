v\",null,{\"data-public-page-shell\":\"true\",\"children\":[[\"$\",\"header\",null,{\"data-public-page-header\":true,\"children\":[\"$\",\"$L10\",null,{\"blogHref\":\"/zh/blog\",\"blogLabel\":\"博客\",\"brandHref\":\"/zh\",\"brandLabel\":\"星露谷物语农场规划器\",\"currentLocale\":\"zh-CN\",\"languageLabel\":\"语言\",\"languageMode\":\"static\",\"localeHrefByLocale\":{\"en\":\"/house-upgrade-stardew\",\"zh-CN\":\"/zh/house-upgrade-stardew\"},\"plannerHref\":\"/zh#planner\",\"plannerLabel\":\"打开规划器\",\"surface\":\"public\"}]}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"article\",null,{\"data-blog-article\":\"true\",\"children\":[[\"$\",\"header\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":\"星露谷物语指南\"}],[\"$\",\"h1\",null,{\"children\":\"星露谷房屋升级：第二档是65,000金和100硬木\"}],[\"$\",\"p\",null,{\"className\":\"blog-article-description\",\"children\":\"第一次农舍升级是10,000金和450木材，第二次是65,000金和100硬木，第三次是100,000金。1.6里，第二次的费用换成现在的数额，不再是50,000金和150硬木。每次升级要三天。第二次升级之后，装修是另一笔订单，而且马上完成。\"}],[\"$\",\"p\",null,{\"children\":[\"作者：\",\" \",\"星露谷规划器团队\",\" · \",\"阅读约 6 分钟\"]}],[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$11\"}]]}],[\"$\",\"div\",null,{\"className\":\"blog-article-layout\",\"children\":[[\"$\",\"$L12\",null,{\"articleId\":\"blog-article-house-upgrade-stardew\",\"label\":\"本页目录\"}],[\"$\",\"div\",null,{\"id\":\"blog-article-house-upgrade-stardew\",\"children\":[\"$\",\"article\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[\"罗宾对第一次农舍升级收取10,000金和450木材，第二次收取65,000金和100硬木，第三次收取100,000金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。第二笔费用是1.6的价格（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Version_History\",\"children\":\"版本历史\"}],\"）。每次升级都要三天（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。到木匠的商店找罗宾下单。\"]}],[\"$\",\"h2\",null,{\"children\":\"每一档升级要花多少\"}],[\"$\",\"div\",null,{\"aria-label\":\"每一档升级要花多少\",\"className\":\"blog-table-scroll\",\"role\":\"region\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"blog-data-table\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"升级\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"金币\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"材料\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"天数\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1\"}],[\"$\",\"td\",null,{\"children\":[\"10,000金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）\"]}],[\"$\",\"td\",null,{\"children\":[\"450木材（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）\"]}],[\"$\",\"td\",null,{\"children\":[\"3（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）\"]}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"2\"}],[\"$\",\"td\",null,{\"children\":[\"65,000金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）\"]}],[\"$\",\"td\",null,{\"children\":[\"100硬木（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）\"]}],[\"$\",\"td\",null,{\"children\":[\"3（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）\"]}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"3\"}],[\"$\",\"td\",null,{\"children\":[\"100,000金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）\"]}],[\"$\",\"td\",null,{}],[\"$\",\"td\",null,{\"children\":[\"3（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）\"]}]]}]]}]]}]}],[\"$\",\"p\",null,{\"children\":[\"在1.6中，第二次房屋升级从50,000金和150硬木改为65,000金和100硬木（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Version_History\",\"children\":\"版本历史\"}],\"）。\"]}],[\"$\",\"h2\",null,{\"children\":\"准备木材和硬木\"}],[\"$\",\"p\",null,{\"children\":[\"你一开始有一把能砍倒完全长成的树的斧头，后续斧头等级在铁匠铺升级（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"斧头\"}],\"）。砍树取得木材，或者从罗宾的普通存货购买木材（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Wood\",\"children\":\"木材\"}],\"）。\"]}],[\"$\",\"p\",null,{\"children\":[\"硬木是另一种物品（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Hardwood\",\"children\":\"硬木\"}],\"）。大树桩（Large Stump）是枯死已久的树留下的残骸。铜斧头（Copper Axe）或更好的斧头能清除大树桩，并得到2硬木（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"大树桩\"}],\"）。它不是你砍活树取木材后留下的那个树桩（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Wood\",\"children\":\"木材\"}],\"）。铜斧头是2,000金和5个铜锭（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"斧头\"}],\"）。钢斧头（Steel Axe）能清除大圆木（Large Log）。钢斧头是5,000金和5个铁锭，也是清除秘密森林入口那根圆木的斧头（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"斧头\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"大圆木\"}],\"）。\"]}],\"$L13\",\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\"]}]}]]}]]}],\"$L2d\"]}],\"$L2e\"]}]\n31:I[23664,[\"8924\",\"static/chunks/8924-26f558a2f8b4bba9.js\",\"4863\",\"static/chunks/4863-6793bdadc5cf1561.js\",\"8615\",\"static/chunks/8615-f8b0d61dbf5d268c.js\",\"5462\",\"static/chunks/5462-3807674a427e7de0.js\",\"6259\",\"static/chunks/app/zh/%5Bslug%5D/page-3b94d7f375b49196.js\"],\"default\"]\n13:[\"$\",\"p\",null,{\"children\":[\"那根圆木清除后，秘密森林从煤矿森林（Cindersap Forest）的西北角打开（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"秘密森林\"}],\"）。这根圆木本身只出一次8硬木，而且不会再长出来（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"大圆木\"}],\"）。里面六棵大树桩每天重新长出，一天一共12硬木。四棵在林子的上半部分。另外两棵在更小的下半区域，要从两条被树盖住的通道之一走进去。一条通道从上方三棵树桩东南方的树丛中直穿过去。另一条从入口南边开始，大约在一丛灌木右侧2-3格，先向南，再向西，再向南（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"秘密森林\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"大树桩\"}],\"）。\"]}]\n14:[\"$\",\"p\",null,{\"children\":[\"如果只靠这些树桩凑100硬木，从0开始，入口圆木已经清除，不算护林人（Forester）多给的那一块，也不算其他硬木来源或消耗。八次收获、每次12块，是96，离100还差4。这4块是2棵树桩，所以第100块出现在第9次收获（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"秘密森林\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"大树桩\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"大圆木\"}],\"）。这个数字是收获次数，不是日历上的日期。钢斧头是这条秘密森林路线的进门工具。第二次升级仍然按那一行的金币和硬木支付，并不是每种拿到这些硬木的办法都需要这把斧头。\"]}]\n15:[\"$\",\"h2\",null,{\"children\":\"先给还缺的木材计价，再累加到某一档\"}]\n16:[\"$\",\"h3\",null,{\"children\":\"手头已经有200木材\"}]\n17:[\"$\",\"p\",null,{\"children\":[\"第一年做第一次升级、而且450木材里已经有200在手上时，用这笔账。这200是你已经有的木材，不是罗宾另外留下的一堆。这次升级是10,000金和450木材，罗宾第一年的木材是10金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。450 − 200 = 250。把这200木材带上，当趟再买另外250。250 × 10金 = 2,500金。加上10,000金的费用，你要带12,500金。这12,500金只包括费用和这次买的木材。\"]}]\n18:[\"$\",\"p\",null,{\"children\":[\"第一年，450 × 10金 = 4,500金，这是木材的价钱；4,500金加上10,000金的费用是14,500金。手头已有的这200，就是把14,500金这个总数改成12,500金的原因。第二年及以后，木材是50金。450 × 50金 = 22,500金，这是木材的价钱；22,500金加上同样的10,000金费用是32,500金（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。12,500金这笔账不用50金这个单价。\"]}]\n19:[\"$\",\"p\",null,{\"children\":[\"罗宾的普通存货出售木材，不出售硬木（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。\"]}]\n1a:[\"$\",\"h3\",null,{\"children\":\"从初始农舍累加到你点名的那一档\"}]\n1b:[\"$\",\"p\",null,{\"children\":[\"这三个总数都从初始农舍算起，把各行加到你点名的那一档为止。它们都不是单独一笔订单的金币（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。\"]}]\n1c:[\"$\",\"p\",null,{\"children\":\"到升级1，各行加起来是10,000金和450木材。到升级2，10,000金 + 65,000金 = 75,000金，另有450木材和100硬木。到升级3，10,000金 + 65,000金 + 100,000金 = 175,000金，另有450木材和100硬木。这些总数只加农舍升级的各行。还要另买的木材，以及铜斧头或钢斧头，都是另外的花费。按费用表交出单独一笔订单的金币。不要在一次到店时支付75,000金或175,000金。\"}]\n1d:[\"$\",\"h2\",null,{\"children\":\"厨房、育儿室和地窖是做什么的\"}]\n1e:[\"$\",\"p\",null,{\"children\":[\"第一次升级在房子里加上厨房。在灶台上烹饪。冰箱有36格，可以当箱子用。一份食谱可以用你物品栏里的食材、那台冰箱里的食材，或一台迷你冰箱（Mini-Fridge）里的食材（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Cooking\",\"children\":\"烹饪\"}],\"）。在厨房水槽给喷壶加水（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。同一次升级加上卧室，并把床从单人床换成双人床（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。\"]}]\n1f:[\"$\",\"p\",null,{\"children\":[\"第二次升级把厨房和卧室加大。新加的房间里，一间是空的。另一间有一张婴儿床和两张儿童床，你可以有两个孩子（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。房间图上的「育儿室」标的就是这间有婴儿床的房间。\"]}]\n2f:[[\"$\",\"source\",null,{\"srcSet\":\"/blog/illustrations/house-upgrade-stardew/tier-rooms.zh.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"三档标注：升级1是厨房和卧室，升级2是空房间和育儿室，升级3是地窖和外观相同，共用一行写着9×5室外。\",\"decoding\":\"async\",\"height\":941,\"loading\":\"lazy\",\"width\":1672,\"src\":\"/blog/illustrations/house-upgrade-stardew/tier-rooms.zh.webp\"}]]\n20:[\"$\",\"figure\",null,{\"className\":\"blog-article-media\",\"children\":[[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$2f\"}],[\"$\",\"figcaption\",null,{\"children\":\"示意图：升级1标着厨房和卧室。升级2标着空房间和育儿室。升级3标着地窖和外观相同。共用一行写着9×5室外。\"}]]}]\n21:[\"$\",\"p\",null,{\"children\":[\"第三次升级在房子下面加上地窖。从厨房进去。地窖一开始有33个木桶（Cask，用来陈酿；不是小桶 Keg）。这些木桶陈酿奶酪和果酒，也陈酿山羊奶酪、啤酒、蜜蜂酒和淡啤酒，陈酿会提高它们的品质和价值。这次升级给出的木桶配方是20木材和1硬木。木桶可以放在别的地方，但只有放在地窖里才会收物品。房子外面和上一次升级时一样（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Cask\",\"children\":\"木桶\"}],\"）。\"]}]\n22:[\"$\",\"p\",null,{\"children\":[\"室外占地保持9×5，所以房子旁边的地块还是原来那样（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。\"]}]\n23:[\"$\",\"h2\",null,{\"children\":\"在山路24号下升级订单\"}]\n24:[\"$\",\"p\",null,{\"children\":[\"罗宾在木匠的商店，山路24号。她出售木材、石头和家具。她升级农舍，也建造农场建筑（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。柜台开着的时候过去，请她升级农舍，并支付下一档的金币和材料。\"]}]\n25:[\"$\",\"p\",null,{\"children\":[\"普通的一周里，柜台从上午9:00开到下午5:00。周二不营业。周五下午4:00关门。房子每天从上午9:00到晚上8:00都能进去，商店关着也能进。走进房子并不会下单（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。\"]}]\n26:[\"$\",\"p\",null,{\"children\":[\"下雨、节日、夏季18日去诊所，以及她走过柜台的那些时候，看\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleyplanner.art/carpenter-stardew\",\"children\":\"罗宾的商店和室外建筑\"}],\"。\"]}]\n27:[\"$\",\"h2\",null,{\"children\":\"装修不是下一次升级\"}]\n30:[[\"$\",\"source\",null,{\"srcSet\":\"/blog/illustrations/house-upgrade-stardew/upgrade-or-renovation.zh.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"两条路径和两个例子：升级写着3天；装修写着升级2之后、即时和退还金币；移除婴儿床写着免费；餐厅写着150,000金。\",\"decoding\":\"async\",\"height\":941,\"loading\":\"lazy\",\"width\":1672,\"src\":\"/blog/illustrations/house-upgrade-stardew/upgrade-or-renovation.zh.webp\"}]]\n28:[\"$\",\"figure\",null,{\"className\":\"blog-article-media\",\"children\":[[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$30\"}],[\"$\",\"figcaption\",null,{\"children\":\"示意图：升级那一路写着升级和3天。装修那一路写着装修、升级2之后、即时和退还金币。移除婴儿床写着免费。餐厅写着150,000金。\"}]]}]\n29:[\"$\",\"p\",null,{\"children\":[\"第二次农舍升级之后，罗宾提供房屋装修。你下一单，马上完成。要撤销，先把新区域清空。然后罗宾退还金币，退款立刻到账（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"、\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"农舍\"}],\"）。\"]}]\n2a:[\"$\",\"p\",null,{\"children\":[\"移除婴儿床免费，而且马上完成（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。餐厅要150,000金，增加一间占地9×10再加4×5的房间，而且马上完成。要把这150,000金拿回来，那片9×10再加4×5的区域必须是空的（\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"木匠的商店\"}],\"）。\"]}]\n2b:[\"$\",\"p\",null,{\"children\":\"想要地窖，就选第三次升级那一行。想要这些改动，就选移除婴儿床或餐厅。\"}]\n32:[[\"$\",\"source\",null,{\"srcSet\":\"/homepage/cases/farm-case-01.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"包含建筑、作物、道路和池塘的星露谷农场布局\",\"className\":\"blog-planner-cta__image\",\"data-blog-planner-cta-image\":\"true\",\"decoding\":\"async\",\"height\":1040,\"loading\":\"lazy\",\"width\":1280,\"src\":\"/homepage/cases/farm-case-01.webp\"}]]\n2c:[[\"$\",\"section\",null,{\"aria-labelledby\":\"blog-planner-cta-heading\",\"className\":\"blog-planner-cta\",\"data-blog-planner-cta\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-planner-cta__content\",\"children\":[[\"$\",\"div\",null,{\"className\":\"blog-planner-cta__copy\",\"children\":[[\"$\",\"p\",null,{\"className\":\"blog-planner-cta__heading\",\"id\":\"blog-planner-cta-heading\",\"children\":[[\"$\",\"span\",null,{\"className\":\"blog-planner-cta__heading-line\",\"children\":[\"星露谷物语\",[\"$\",\"em\",null,{\"children\":\"规划器\"}]]}],[\"$\",\"span\",null,{\"className\":\"blog-planner-cta__heading-line\",\"children\":\"免费在线农场布局工具\"}]]}],[\"$\",\"p\",null,{\"className\":\"blog-planner-cta__description\",\"children\":\"别等建筑落地后才发现布局不顺。先在浏览器中试排 8 种农场，摆放建筑和作物、检查四季与覆盖范围，再照着方案进游戏建造。\"}],[\"$\",\"a\",null,{\"href\":\"/zh#planner\",\"children\":[\"开始规划我的农场\",[\"$\",\"$L31\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right\",\"aria-hidden\":\"true\",\"data-icon\":\"inline-end\"}]],\"data-slot\":\"button\",\"data-variant\":\"default\",\"data-size\":\"lg\",\"className\":\"group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 [\u0026_svg]:pointer-events-none [\u0026_svg]:shrink-0 [\u0026_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground hover:bg-primary/80 h-9 gap-1.5 px-2.5 has-data-[icon=inline-end]:pr-2 has-data-[icon=inline-start]:pl-2\",\"data-blog-planner-cta-action\":\"true\",\"ref\":null}],[\"$\",\"p\",null,{\"className\":\"blog-planner-cta__note\",\"children\":\"免费使用 · 无需注册\"}]]}],[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$32\"}]]}]}],[\"$\",\"section\",null,{\"className\":\"blog-sources\",\"children\":[\"$\",\"div\",null,{\"data-slot\":\"card\",\"data-size\":\"default\",\"className\":\"group/card flex flex-col gap-(--card-spacing) overflow-hidden rounded-xl bg-card py-(--card-spacing) text-sm text-card-foreground ring-1 ring-foreground/10 [--card-spacing:--spacing(4)] has-data-[slot=card-footer]:pb-0 has-[\u003eimg:first-child]:pt-0 data-[size=sm]:[--card-spacing:--spacing(3)] data-[size=sm]:has-data-[slot=card-footer]:pb-0 *:[img:first-child]:rounded-t-xl *:[img:last-child]:rounded-b-xl blog-sources__card\",\"children\":[[\"$\",\"div\",null,{\"data-slot\":\"card-header\",\"className\":\"group/card-header @container/card-header grid auto-rows-min items-start gap-1 rounded-t-xl px-(--card-spacing) has-data-[slot=card-action]:grid-cols-[1fr_auto] has-data-[slot=card-description]:grid-rows-[auto_auto] [.border-b]:pb-(--card-spacing) blog-sources__header\",\"children\":[\"$\",\"div\",null,{\"data-slot\":\"card-title\",\"className\":\"cn-font-heading text-base leading-snug font-medium group-data-[size=sm]/card:text-sm blog-sources__title\",\"children\":[[\"$\",\"$L31\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M12 5v16\",\"key\":\"1f6ucr\"}],[\"path\",{\"d\":\"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z\",\"key\":\"1fyvmf\"}]],\"className\":\"lucide-book-open blog-sources__title-icon\",\"aria-hidden\":true}],[\"$\",\"h2\",null,{\"children\":\"来源\"}]]}]}],[\"$\",\"div\",null,{\"data-slot\":\"card-content\",\"className\":\"px-(--card-spacing) blog-sources__content\",\"children\":[\"$\",\"div\",null,{\"role\":\"list\",\"data-slot\":\"item-group\",\"className\":\"group/item-group flex w-full flex-col gap-4 has-data-[size=sm]:gap-2.5 has-data-[size=xs]:gap-2 blog-sources__list\",\"children\":[[\"$\",\"div\",\"https://stardewvalleywiki.com/Farmhouse\",{\"className\":\"blog-sources__item-wrapper\",\"role\":\"lis