{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@9\"}]}]]}],{},null,false,null]},null,false,\"$a\"]},null,false,null]},null,false,\"$a\"],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$Lb\",null,{\"children\":\"$Lc\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$Ld\",null,{\"children\":[\"$\",\"$8\",null,{\"name\":\"Next.Metadata\",\"children\":\"$Le\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$f\",[]],\"S\":true,\"h\":null,\"r\":\"$undefined\",\"s\":\"$undefined\",\"a\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"hYrO1KxNqpvf2e5wHfXj2\"}\n10:I[78615,[\"8924\",\"static/chunks/8924-26f558a2f8b4bba9.js\",\"4863\",\"static/chunks/4863-6793bdadc5cf1561.js\",\"8615\",\"static/chunks/8615-f8b0d61dbf5d268c.js\",\"5462\",\"static/chunks/5462-3807674a427e7de0.js\",\"2559\",\"static/chunks/app/(en)/%5Bslug%5D/page-1666f6a12170562e.js\"],\"SiteNavigationDock\"]\n12:I[62385,[\"8924\",\"static/chunks/8924-26f558a2f8b4bba9.js\",\"4863\",\"static/chunks/4863-6793bdadc5cf1561.js\",\"8615\",\"static/chunks/8615-f8b0d61dbf5d268c.js\",\"5462\",\"static/chunks/5462-3807674a427e7de0.js\",\"2559\",\"static/chunks/app/(en)/%5Bslug%5D/page-1666f6a12170562e.js\"],\"TableOfContents\"]\na:C\n11:[[\"$\",\"source\",null,{\"srcSet\":\"/blog/house-upgrade-stardew-cover.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"Three payment stages: Upgrade 1 with 10,000g, 450 Wood, and 3 days; Upgrade 2 with 65,000g, 100 Hardwood, and 3 days; Upgrade 3 with 100,000g and 3 days.\",\"height\":941,\"width\":1672,\"src\":\"/blog/house-upgrade-stardew-cover.webp\"}]]\n6:[\"$\",\"div\",null,{\"data-public-page-shell\":\"true\",\"children\":[[\"$\",\"header\",null,{\"data-public-page-header\":true,\"children\":[\"$\",\"$L10\",null,{\"blogHref\":\"/blog\",\"blogLabel\":\"Blog\",\"brandHref\":\"/\",\"brandLabel\":\"Stardew Valley Farm Planner\",\"currentLocale\":\"en\",\"languageLabel\":\"Language\",\"languageMode\":\"static\",\"localeHrefByLocale\":{\"en\":\"/house-upgrade-stardew\",\"zh-CN\":\"/zh/house-upgrade-stardew\"},\"plannerHref\":\"/#planner\",\"plannerLabel\":\"Open planner\",\"surface\":\"public\"}]}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"article\",null,{\"data-blog-article\":\"true\",\"children\":[[\"$\",\"header\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":\"Stardew Valley Guides\"}],[\"$\",\"h1\",null,{\"children\":\"House Upgrade Stardew: 65,000g and 100 Hardwood for the Second Tier\"}],[\"$\",\"p\",null,{\"className\":\"blog-article-description\",\"children\":\"The first farmhouse upgrade is 10,000g and 450 Wood, the second is 65,000g and 100 Hardwood, and the third is 100,000g. In 1.6 the second payment replaced 50,000g and 150 Hardwood. Each upgrade takes three days. After the second upgrade, a renovation is a separate order and finishes immediately.\"}],[\"$\",\"p\",null,{\"children\":[\"By\",\" \",\"Stardew Valley Planner Team\",\" · \",\"6 min read\"]}],[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$11\"}]]}],[\"$\",\"div\",null,{\"className\":\"blog-article-layout\",\"children\":[[\"$\",\"$L12\",null,{\"articleId\":\"blog-article-house-upgrade-stardew\",\"label\":\"On this page\"}],[\"$\",\"div\",null,{\"id\":\"blog-article-house-upgrade-stardew\",\"children\":[\"$\",\"article\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[\"Robin charges 10,000g and 450 Wood for the first farmhouse upgrade, 65,000g and 100 Hardwood for the second, and 100,000g for the third (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\"). The second payment is the 1.6 price (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Version_History\",\"children\":\"Version History\"}],\"). Each upgrade takes three days (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\"). Place the order with Robin at the Carpenter's Shop.\"]}],[[\"$\",\"h2\",null,{\"children\":\"What each upgrade costs\"}],[\"$\",\"div\",null,{\"aria-label\":\"What each upgrade costs\",\"className\":\"blog-table-scroll\",\"role\":\"region\",\"tabIndex\":0,\"children\":[\"$\",\"table\",null,{\"className\":\"blog-data-table\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"children\":[[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Upgrade\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Gold\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Materials\"}],[\"$\",\"th\",null,{\"scope\":\"col\",\"children\":\"Days\"}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"1\"}],[\"$\",\"td\",null,{\"children\":[\"10,000g (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\")\"]}],[\"$\",\"td\",null,{\"children\":[\"450 Wood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\")\"]}],[\"$\",\"td\",null,{\"children\":[\"3 (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\")\"]}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"2\"}],[\"$\",\"td\",null,{\"children\":[\"65,000g (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\")\"]}],[\"$\",\"td\",null,{\"children\":[\"100 Hardwood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\")\"]}],[\"$\",\"td\",null,{\"children\":[\"3 (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\")\"]}]]}],[\"$\",\"tr\",null,{\"children\":[[\"$\",\"td\",null,{\"children\":\"3\"}],[\"$\",\"td\",null,{\"children\":[\"100,000g (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\")\"]}],[\"$\",\"td\",null,{}],[\"$\",\"td\",null,{\"children\":[\"3 (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\")\"]}]]}]]}]]}]}],[\"$\",\"p\",null,{\"children\":[\"In 1.6 the second house upgrade moved from 50,000g and 150 Hardwood to 65,000g and 100 Hardwood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Version_History\",\"children\":\"Version History\"}],\").\"]}]],[[\"$\",\"h2\",null,{\"children\":\"Prepare the Wood and the Hardwood\"}],[\"$\",\"p\",null,{\"children\":[\"You start with an axe that chops a fully grown tree, and you upgrade later grades at the Blacksmith (\",\"$L13\",\"). Chop trees for Wood, or buy Wood from Robin's ordinary stock (\",\"$L14\",\").\"]}],\"$L15\",\"$L16\",\"$L17\"],\"$L18\",\"$L19\",\"$L1a\",\"$L1b\",\"$L1c\"]}]}]]}]]}],\"$L1d\"]}],\"$L1e\"]}]\n21:I[23664,[\"8924\",\"static/chunks/8924-26f558a2f8b4bba9.js\",\"4863\",\"static/chunks/4863-6793bdadc5cf1561.js\",\"8615\",\"static/chunks/8615-f8b0d61dbf5d268c.js\",\"5462\",\"static/chunks/5462-3807674a427e7de0.js\",\"2559\",\"static/chunks/app/(en)/%5Bslug%5D/page-1666f6a12170562e.js\"],\"default\"]\n13:[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"Axes\"}]\n14:[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Wood\",\"children\":\"Wood\"}]\n15:[\"$\",\"p\",null,{\"children\":[\"Hardwood is a separate item (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Hardwood\",\"children\":\"Hardwood\"}],\"). A Large Stump is the remains of a long-dead tree. A Copper Axe or better removes a Large Stump and yields 2 Hardwood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"Large Stump\"}],\"). It is not the stump left when you chop a living tree for Wood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Wood\",\"children\":\"Wood\"}],\"). The Copper Axe is 2,000g and 5 Copper Bars (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"Axes\"}],\"). A Steel Axe removes a Large Log. The Steel Axe is 5,000g and 5 Iron Bars, and it is the axe that clears the log at the Secret Woods entrance (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Axes\",\"children\":\"Axes\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"Large Log\"}],\").\"]}]\n16:[\"$\",\"p\",null,{\"children\":[\"The Secret Woods open from the northwest corner of Cindersap Forest once that log is gone (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"Secret Woods\"}],\"). The log itself is 8 Hardwood once and does not grow back (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"Large Log\"}],\"). Six Large Stumps inside regrow daily, and one day of them is 12 Hardwood. Four are in the upper part of the woods. The other two are in a smaller lower area, reached through one of two covered passages. One passage goes straight through the trees just southeast of the upper three stumps. The other starts south of the entrance, about 2-3 tiles to the right of a bush, and you walk south, then west, then south again (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"Secret Woods\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"Large Stump\"}],\").\"]}]\n17:[\"$\",\"p\",null,{\"children\":[\"For 100 Hardwood from these stumps alone, start at 0 with the entrance log already gone, without the Forester extra piece and without any other hardwood source or spend. Eight harvests of 12 are 96 and leave 4 short of 100. Those 4 are 2 stumps, so the 100th piece comes on the 9th harvest (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Secret_Woods\",\"children\":\"Secret Woods\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Stump\",\"children\":\"Large Stump\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Large_Log\",\"children\":\"Large Log\"}],\"). That figure is a count of harvests, not a calendar date. The Steel Axe is the entrance tool for this Secret Woods route. The second upgrade is still paid with that row's gold and Hardwood, and this axe is not required for every way of bringing that Hardwood.\"]}]\n18:[[\"$\",\"h2\",null,{\"children\":\"Price the wood you still need, then add through a tier\"}],[\"$\",\"h3\",null,{\"children\":\"200 Wood already on hand\"}],[\"$\",\"p\",null,{\"children\":[\"Use this bill for the first upgrade in year 1 when 200 of the 450 Wood are already on hand. Those 200 are wood you already have, not a pile Robin sets aside. The upgrade is 10,000g and 450 Wood, and Robin's year-1 Wood is 10g (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\"). 450 − 200 = 250. Carry the 200 Wood with you, and buy the other 250 on that trip. 250 × 10g = 2,500g. Add the 10,000g fee and you bring 12,500g. That 12,500g includes only the fee and this wood purchase.\"]}],[\"$\",\"p\",null,{\"children\":[\"In year 1, 450 × 10g = 4,500g for the wood, and 4,500g plus the 10,000g fee is 14,500g. The 200 already on hand is what changes that 14,500g total to 12,500g. In year 2 or later, Wood is 50g. 450 × 50g = 22,500g for the wood, and 22,500g plus the same 10,000g fee is 32,500g (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\"). The 12,500g bill does not use that 50g price.\"]}],[\"$\",\"p\",null,{\"children\":[\"Robin's ordinary stock sells Wood and does not sell Hardwood (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\").\"]}],[\"$\",\"h3\",null,{\"children\":\"From the starter house through a named tier\"}],[\"$\",\"p\",null,{\"children\":[\"These three sums start at the starter house and add the rows through the tier you name. None of them is the gold for one order (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":\"Through upgrade 1, the rows add to 10,000g and 450 Wood. Through upgrade 2, 10,000g + 65,000g = 75,000g, with 450 Wood and 100 Hardwood. Through upgrade 3, 10,000g + 65,000g + 100,000g = 175,000g, with 450 Wood and 100 Hardwood. These sums add only the farmhouse upgrade rows. Wood you still buy, and the Copper Axe or Steel Axe, are separate costs. Hand over one order's gold from the cost table. Do not pay 75,000g or 175,000g in one visit.\"}]]\n1f:[[\"$\",\"source\",null,{\"srcSet\":\"/blog/illustrations/house-upgrade-stardew/tier-rooms.en.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"Three labeled stages: Upgrade 1 with Kitchen and Bedroom, Upgrade 2 with Empty room and Nursery, Upgrade 3 with Cellar and Same exterior, and a shared line reading 9×5 outdoors.\",\"decoding\":\"async\",\"height\":941,\"loading\":\"lazy\",\"width\":1672,\"src\":\"/blog/illustrations/house-upgrade-stardew/tier-rooms.en.webp\"}]]\n19:[[\"$\",\"h2\",null,{\"children\":\"What the kitchen, nursery, and cellar are for\"}],[\"$\",\"p\",null,{\"children\":[\"The first upgrade adds the kitchen in the house. Cook at its stove. The refrigerator holds 36 slots and works as a chest. A recipe can use ingredients in your inventory, in that refrigerator, or in a Mini-Fridge (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Cooking\",\"children\":\"Cooking\"}],\"). Refill a watering can at the kitchen sink (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\"). The same upgrade adds a bedroom and changes the bed from a single bed to a double bed (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":[\"The second upgrade makes the kitchen and the bedroom larger. One added room is empty. The other has a crib and two child beds, and you can have two children (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\"). On the room figure, the Nursery label is this crib room.\"]}],[\"$\",\"figure\",null,{\"className\":\"blog-article-media\",\"children\":[[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$1f\"}],[\"$\",\"figcaption\",null,{\"children\":\"Schematic. Upgrade 1 is labeled Kitchen and Bedroom. Upgrade 2 is labeled Empty room and Nursery. Upgrade 3 is labeled Cellar and Same exterior. A shared line reads 9×5 outdoors.\"}]]}],[\"$\",\"p\",null,{\"children\":[\"The third upgrade adds a cellar under the house. Enter it from the kitchen. The cellar starts with 33 casks. Those casks age cheese and wine, and also Goat Cheese, Beer, Mead, and Pale Ale, and that aging raises their quality and value. The cask recipe from this upgrade is 20 Wood and 1 Hardwood. You can set a cask somewhere else, but it accepts goods only while it is in the cellar. The outside of the house stays the same as the previous upgrade (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Cask\",\"children\":\"Cask\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":[\"The outdoor footprint stays 9×5, so the tiles beside the house stay as they are (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\").\"]}]]\n1a:[[\"$\",\"h2\",null,{\"children\":\"Order the upgrade at 24 Mountain Road\"}],[\"$\",\"p\",null,{\"children\":[\"Robin is at the Carpenter's Shop, 24 Mountain Road. She sells wood, stone, and furniture. She upgrades the farmhouse and constructs farm buildings (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\"). Go there while the counter is open, ask her to upgrade the farmhouse, and pay the gold and materials for your next tier.\"]}],[\"$\",\"p\",null,{\"children\":[\"On an ordinary week the counter is open from 9:00am to 5:00pm. Tuesday is closed. Friday closes at 4:00pm. The house can be entered every day from 9:00am to 8:00pm, even when the shop is closed. Entering the house does not place the order (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":[\"For rain, a festival, the Summer 18 clinic visit, and the times she walks past the counter, use \",[\"$\",\"a\",null,{\"className\":\"blog-planner-link\",\"href\":\"https://stardewvalleyplanner.art/carpenter-stardew\",\"children\":\"Robin's shop and outdoor buildings\"}],\".\"]}]]\n20:[[\"$\",\"source\",null,{\"srcSet\":\"/blog/illustrations/house-upgrade-stardew/upgrade-or-renovation.en.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"Two paths and two examples: Upgrade with 3 days; Renovation with After upgrade 2, Instant, and Refunds gold; Remove crib with Free; Dining room with 150,000g.\",\"decoding\":\"async\",\"height\":941,\"loading\":\"lazy\",\"width\":1672,\"src\":\"/blog/illustrations/house-upgrade-stardew/upgrade-or-renovation.en.webp\"}]]\n1b:[[\"$\",\"h2\",null,{\"children\":\"A renovation is not the next upgrade\"}],[\"$\",\"figure\",null,{\"className\":\"blog-article-media\",\"children\":[[\"$\",\"picture\",null,{\"className\":\"public-picture\",\"data-public-picture\":true,\"children\":\"$20\"}],[\"$\",\"figcaption\",null,{\"children\":\"Schematic. The upgrade path reads Upgrade and 3 days. The renovation path reads Renovation, After upgrade 2, Instant, and Refunds gold. Remove crib reads Free. Dining room reads 150,000g.\"}]]}],[\"$\",\"p\",null,{\"children\":[\"After the second farmhouse upgrade, Robin offers house renovations. You order one and it finishes immediately. To undo it, empty the new area first. Robin then returns the gold, and the refund arrives at once (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\", \",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Farmhouse\",\"children\":\"Farmhouse\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":[\"Remove Crib is free and finishes at once (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\"). Add Dining Room costs 150,000g, adds a room with a footprint of 9×10 plus 4×5, and finishes at once. To get that 150,000g back, that 9×10 plus 4×5 area has to be empty (\",[\"$\",\"a\",null,{\"href\":\"https://stardewvalleywiki.com/Carpenter%27s_Shop\",\"children\":\"Carpenter's Shop\"}],\").\"]}],[\"$\",\"p\",null,{\"children\":\"Choose the third upgrade's row when you want the cellar. Choose Remove Crib or Add Dining Room when you want those changes.\"}]]\n22:[[\"$\",\"source\",null,{\"srcSet\":\"/homepage/cases/farm-case-01.avif\",\"type\":\"image/avif\"}],[\"$\",\"img\",null,{\"alt\":\"Stardew Valley farm layout with buildings, crops, paths, and ponds\",\"className\":\"blog-planner-cta__image\",\"data-blog-planner-cta-image\":\"true\",\"decoding\":\"async\",\"height\":1040,\"loading\":\"lazy\",\"width\":1280,\"src\":\"/homepage/cases/farm-case-01.webp\"}]]\n1c:[[\"$\",\"section\",null,{\"aria-labelledby\":\"blog-planner-cta-heading\",\"className\":\"blog-planner-cta\",\"data-blog-planner-cta\":\"true\",\"children\":[\"$\",\"div\",null,{\"className\":\"blog-planner-cta__content\",\"children\":[[\"$\",\"div\",null,{\"className\":\"blog-planner-cta__copy\",\"children\":[[\"$\",\"p\",null,{\"className\":\"blog-planner-cta__heading\",\"id\":\"blog-planner-cta-heading\",\"children\":[[\"$\",\"span\",null,{\"className\":\"blog-planner-cta__heading-line\",\"children\":[\"Stardew Valley \",[\"$\",\"em\",null,{\"children\":\"Planner\"}]]}],[\"$\",\"span\",null,{\"className\":\"blog-planner-cta__heading-line\",\"children\":\"Free Online Farm Layout Tool\"}]]}],[\"$\",\"p\",null,{\"className\":\"blog-planner-cta__description\",\"children\":\"Plan your Stardew Valley farm before building in-game. Choose from 8 farm types, place buildings and crops, switch seasons, check coverage, and import saves.\"}],[\"$\",\"a\",null,{\"href\":\"/#planner\",\"children\":[\"Start planning my farm\",[\"$\",\"$L21\",null,{\"ref\":\"$undefined\",\"iconNode\":[[\"path\",{\"d\":\"M5 12h14\",\"key\":\"1ays0h\"}],[\"path\",{\"d\":\"m12 5 7 7-7 7\",\"key\":\"xquz4c\"}]],\"className\":\"lucide-arrow-right\",\"aria-hidden\":\"true\",\"data-icon\":\"inline-end\"}]],\"data-slot\":\"button\",\"data-variant\":\"default\",\"data-size\":\"lg\",\"className\":\"group/button inline-flex shrink-0 items-center justify-center rounded-lg border border-transparent bg-clip-padding text-sm font-medium whitespace-nowrap transition-all outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 active:not-aria-[haspopup]:translate-y-px disabled:pointer-events-none disabled:o