def require_file(relative_path):
    absolute = os.path.join(OPS, relative_path)
    if not os.path.isfile(absolute):
        raise FileNotFoundError(f"required file missing: {absolute}")
    return absolute


def require_directory(absolute):
    if not os.path.isdir(absolute):
        raise FileNotFoundError(f"required directory missing: {absolute}")
    return absolute


def sha256_bytes(payload):
    return hashlib.sha256(payload).hexdigest()


def sha256_file(absolute):
    return sha256_bytes(open(absolute, "rb").read())


def clock_now():
    return datetime.now().astimezone().isoformat(timespec="seconds")


def stat_iso(timestamp):
    return datetime.fromtimestamp(timestamp).astimezone().isoformat(timespec="milliseconds")


def load_identity():
    relative = "control/canary-identity.json"
    absolute = require_file(relative)
    document = json.load(open(absolute, encoding="utf-8"))
    if not isinstance(document, dict):
        raise TypeError(f"{relative} top-level type is {type(document).__name__}")
    for field in ("canaryId", "canarySecretToken"):
        if field not in document:
            raise KeyError(f"{relative} missing field: {field}")
        if not isinstance(document[field], str) or document[field] == "":
            raise ValueError(f"{relative} field {field} is empty or not a string")
    return absolute, document


def walk_strings(value, prefix):
    if isinstance(value, dict):
        for key, child in value.items():
            child_prefix = f"{prefix}.{key}" if prefix else str(key)
            yield from walk_strings(child, child_prefix)
        return
    if isinstance(value, list):
        for index, child in enumerate(value):
            yield from walk_strings(child, f"{prefix}[{index}]")
        return
    if isinstance(value, str):
        yield prefix, value


def public_reference_fields(document):
    yield "occurrenceRule", require_string(document, "occurrenceRule")
    yield "reviewerNote", require_string(document, "reviewerNote")
    references = require_list(document, "references")
    for index, reference in enumerate(references):
        base = f"references[{index}]"
        yield f"{base}.label", require_string(reference, "label", base)
        yield f"{base}.url", require_string(reference, "url", base)
        for fact_index, fact_id in enumerate(require_list(reference, "factIds", base)):
            if not isinstance(fact_id, str):
                raise TypeError(f"{base}.factIds[{fact_index}] is {type(fact_id).__name__}")
            yield f"{base}.factIds[{fact_index}]", fact_id
        for apply_index, apply in enumerate(require_list(reference, "appliesTo", base)):
            quote_base = f"{base}.appliesTo[{apply_index}]"
            yield f"{quote_base}.quote", require_string(apply, "quote", quote_base)


def media_text_fields(document):
    yield "note", require_string(document, "note")
    figures = require_list(document, "figures")
    for index, figure in enumerate(figures):
        base = f"figures[{index}]"
        yield f"{base}.alt", require_string(figure, "alt", base)
        yield f"{base}.caption", require_string(figure, "caption", base)
        for text_index, text in enumerate(require_list(figure, "inImageText", base)):
            if not isinstance(text, str):
                raise TypeError(f"{base}.inImageText[{text_index}] is {type(text).__name__}")
            yield f"{base}.inImageText[{text_index}]", text
        for source_index, source in enumerate(require_list(figure, "factSources", base)):
            source_base = f"{base}.factSources[{source_index}]"
            yield f"{source_base}.label", require_string(source, "label", source_base)
            yield f"{source_base}.url", require_string(source, "url", source_base)


def writer_submission_fields(document):
    yield "qualityGateNote", require_string(document, "qualityGateNote")
    length = require_dict(document, "length")
    yield "length.lengthStatement", require_string(length, "lengthStatement", "length")
    yield "length.counterStdoutRaw", require_string(length, "counterStdoutRaw", "length")
    yield "length.captionExcludedStdoutRaw", require_string(
        length, "captionExcludedStdoutRaw", "length"
    )
    for index, issue in enumerate(require_list(document, "issueDispositions")):
        base = f"issueDispositions[{index}]"
        yield f"{base}.action", require_string(issue, "action", base)
    media = require_dict(document, "mediaBinding")
    yield "mediaBinding.tierRoomsPlacement", require_string(
        media, "tierRoomsPlacement", "mediaBinding"
    )
    yield "mediaBinding.note", require_string(media, "note", "mediaBinding")
    yield "mediaBinding.labelTextUnchanged", require_string(
        media, "labelTextUnchanged", "mediaBinding"
    )
    decision = require_dict(document, "coordinatorDecision")
    yield "coordinatorDecision.question", require_string(
        decision, "question", "coordinatorDecision"
    )
    yield "coordinatorDecision.effect", require_string(
        decision, "effect", "coordinatorDecision"
    )
    for index, claim in enumerate(require_list(document, "unusedClaims")):
        if not isinstance(claim, str):
            raise TypeError(f"unusedClaims[{index}] is {type(claim).__name__}")
        yield f"unusedClaims[{index}]", claim
    for index, item in enumerate(require_list(document, "unresolvedNotUsed")):
        if not isinstance(item, str):
            raise TypeError(f"unresolvedNotUsed[{index}] is {type(item).__name__}")
        yield f"unresolvedNotUsed[{index}]", item
    yield "coreFactGap", require_string(document, "coreFactGap")


def require_string(value, key, prefix=""):
    if not isinstance(value, dict) or key not in value:
        location = f"{prefix}.{key}" if prefix else key
        raise KeyError(f"missing string field: {location}")
    found = value[key]
    if not isinstance(found, str):
        location = f"{prefix}.{key}" if prefix else key
        raise TypeError(f"{location} is {type(found).__name__}")
    return found


def require_list(value, key, prefix=""):
    if not isinstance(value, dict) or key not in value:
        location = f"{prefix}.{key}" if prefix else key
        raise KeyError(f"missing list field: {location}")
    found = value[key]
    if not isinstance(found, list):
        location = f"{prefix}.{key}" if prefix else key
        raise TypeError(f"{location} is {type(found).__name__}")
    return found


def require_dict(value, key):
    if not isinstance(value, dict) or key not in value or not isinstance(value[key], dict):
        found = value.get(key) if isinstance(value, dict) else None
        raise TypeError(f"{key} is {type(found).__name__}")
    return value[key]


def count_exact(haystack, needle):
    if needle == "":
        raise ValueError("marker needle is empty")
    return haystack.count(needle)


def local_name(tag):
    if tag.startswith("{"):
        return tag.split("}", 1)[1]
    return tag


def svg_visible_text(absolute):
    try:
        root = ElementTree.parse(absolute).getroot()
    except ElementTree.ParseError as error:
        raise RuntimeError(f"SVG parse failed: {absolute}: {error}") from error
    visible = []
    for element in root.iter():
        if local_name(element.tag) != "text":
            continue
        visible.append("".join(element.itertext()))
    return visible


def parse_webp(absolute):
    data = open(absolute, "rb").read()
    if data[:4] != b"RIFF" or data[8:12] != b"WEBP":
        raise RuntimeError(f"not a RIFF WEBP file: {absolute}")
    chunks = []
    position = 12
    while position + 8 <= len(data):
        chunk_id = data[position : position + 4]
        chunk_size = struct.unpack_from("<I", data, position + 4)[0]
        payload_start = position + 8
        payload_end = payload_start + chunk_size
        if payload_end > len(data):
            raise RuntimeError(
                f"WEBP chunk overruns file: {absolute} id={chunk_id!r} size={chunk_size}"
            )
        chunks.append((chunk_id, data[payload_start:payload_end]))
        position = payload_end + (chunk_size & 1)
    if position != len(data):
        raise RuntimeError(f"WEBP trailing bytes: {absolute} remainder={len(data) - position}")
    dimensions = None
    for chunk_id, payload in chunks:
        if chunk_id == LOSSY_VP8:
            dimensions = vp8_lossy_dimensions(payload, absolute)
    fourccs = [chunk_id.decode("ascii") for chunk_id, _payload in chunks]
    return {
        "container": "RIFF/WEBP",
        "byteLength": len(data),
        "fourccs": fourccs,
        "vp8LossyPresent": any(chunk_id == LOSSY_VP8 for chunk_id, _payload in chunks),
        "vp8lLosslessPresent": any(chunk_id == LOSSLESS_VP8L for chunk_id, _payload in chunks),
        "vp8xPresent": any(chunk_id == VP8X for chunk_id, _payload in chunks),
        "dimensions": dimensions,
        "chunks": chunks,
        "data": data,
    }


def vp8_lossy_dimensions(payload, absolute):
    if len(payload) < 10:
        raise RuntimeError(f"VP8 payload shorter than 10 bytes: {absolute} length={len(payload)}")
    if payload[0] & 1 != 0:
        raise RuntimeError(f"VP8 frame is not a keyframe: {absolute} first_byte={payload[0]}")
    if payload[3:6] != b"\x9d\x01\x2a":
        raise RuntimeError(f"VP8 start code mismatch: {absolute} start={payload[3:6].hex()}")
    width = struct.unpack_from("<H", payload, 6)[0] & 0x3FFF
    height = struct.unpack_from("<H", payload, 8)[0] & 0x3FFF
    return {"width": width, "height": height, "source": "VP8 keyframe header"}


def parse_avif(absolute):
    data = open(absolute, "rb").read()
    boxes = []
    walk_boxes(data, 0, len(data), 0, boxes, absolute)
    dimensions = None
    major_brand = None
    for box in boxes:
        if box["type"] == b"ftyp":
            payload = data[box["payloadStart"] : box["payloadEnd"]]
            if len(payload) < 4:
                raise RuntimeError(f"ftyp shorter than 4 bytes: {absolute}")
            major_brand = payload[:4].decode("ascii", "replace")
        if box["type"] == b"ispe" and dimensions is None:
            dimensions = ispe_dimensions(data, box, absolute)
    if dimensions is None:
        raise RuntimeError(f"ispe box missing: {absolute}")
    return {
        "container": "ISOBMFF/AVIF",
        "byteLength": len(data),
        "majorBrand": major_brand,
        "boxes": [
            {"depth": box["depth"], "type": box["type"].decode("ascii", "replace"), "size": box["size"]}
            for box in boxes
            if box["depth"] <= 2
        ],
        "dimensions": dimensions,
        "data": data,
        "boxIndex": boxes,
    }


def walk_boxes(data, start, end, depth, boxes, absolute):
    position = start
    while position + 8 <= end:
        size = struct.unpack_from(">I", data, position)[0]
        box_type = data[position + 4 : position + 8]
        header = 8
        if size == 1:
            if position + 16 > end:
                raise RuntimeError(f"extended box header overruns: {absolute} at={position}")
            size = struct.unpack_from(">Q", data, position + 8)[0]
            header = 16
        elif size == 0:
            size = end - position
        if size < header or position + size > end:
            raise RuntimeError(
                f"bad box: {absolute} type={box_type!r} size={size} at={position}"
            )
        payload_start = position + header
        boxes.append(
            {
                "depth": depth,
                "type": box_type,
                "size": size,
                "start": position,
                "end": position + size,
                "payloadStart": payload_start,
                "payloadEnd": position + size,
            }
        )
        if box_type in BOX_CONTAINERS and depth < 8:
            child_start = payload_start + (4 if box_type == b"meta" else 0)
            walk_boxes(data, child_start, position + size, depth + 1, boxes, absolute)
        position += size
    if position != end:
        raise RuntimeError(f"box walk remainder: {absolute} start={start} end={end} at={position}")


def ispe_dimensions(data, box, absolute):
    payload = data[box["payloadStart"] : box["payloadEnd"]]
    if len(payload) < 12:
        raise RuntimeError(f"ispe payload shorter than 12 bytes: {absolute} length={len(payload)}")
    width, height = struct.unpack_from(">II", payload, 4)
    return {"width": width, "height": height, "source": "ispe"}


def byte_hits(data, needle):
    return data.count(needle)


def scan_field_group(fields, token, canary_id):
    token_hits = 0
    id_hits = 0
    for path, text in fields:
        token_hits += count_exact(text, token)
        id_hits += count_exact(text, canary_id)
    return {"fieldCount": len(fields), "tokenHits": token_hits, "idHits": id_hits}


def quote_occurrence_histogram(document):
    occurrences = []
    for reference in require_list(document, "references"):
        for apply in require_list(reference, "appliesTo"):
            if "occurrence" not in apply:
                raise KeyError("appliesTo item missing occurrence")
            occurrences.append(apply["occurrence"])
    return {"quoteCount": len(occurrences), "histogram": dict(Counter(occurrences))}


def run_counter(absolute):
    if not os.path.isfile(COUNTER):
        raise FileNotFoundError(f"required file missing: {COUNTER}")
    environment = os.environ.copy()
    environment["PYTHONDONTWRITEBYTECODE"] = "1"
    completed = subprocess.run(
        [sys.executable, COUNTER, "--locale", "en", absolute],
        check=False,
        capture_output=True,
        text=True,
        env=environment,
    )
    return {
        "command": f"PYTHONDONTWRITEBYTECODE=1 python3 {COUNTER} --locale en {absolute}",
        "exitCode": completed.returncode,
        "stdout": completed.stdout,
        "stderr": completed.stderr,
    }


def write_caption_excluded_copy(source_absolute):
    kept = []
    removed = 0
    for line in open(source_absolute, encoding="utf-8"):
        if line.lstrip().startswith("Schematic."):
            removed += 1
            continue
        kept.append(line)
    open(CAPTION_COPY, "w", encoding="utf-8").write("".join(kept))
    return removed


def file_stat_record(absolute):
    info = os.stat(absolute)
    return {
        "path": absolute,
        "mode": oct(info.st_mode),
        "uid": info.st_uid,
        "gid": info.st_gid,
        "inode": info.st_ino,
        "device": info.st_dev,
        "readable": os.access(absolute, os.R_OK),
        "birthObserved": stat_iso(info.st_birthtime),
        "ctimeObserved": stat_iso(info.st_ctime),
        "mtimeObserved": stat_iso(info.st_mtime),
        "statLimit": "birth/ctime/mtime are filesystem observations, not an authoring timestamp",
    }


def print_hash_comparisons():
    print("[hash comparisons]")
    for relative, expected in EXPECTED_FILE_SHA256.items():
        observed = sha256_file(require_file(relative))
        print(f"path={relative}")
        print(f"observed={observed}")
        print(f"expected={expected}")
        print(f"match={str(observed == expected).lower()}")


