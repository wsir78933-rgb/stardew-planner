            f"path={record['path']} birth={record['birthObserved']} "
            f"ctime={record['ctimeObserved']} mtime={record['mtimeObserved']}"
        )
    print(record_limit())


def record_limit():
    return "statLimit=filesystem observation only; not asserted as the authoring instant"


def scan_json_documents(token, canary_id):
    collectors = {
        "content/en/public-references.en.json": public_reference_fields,
        "content/en/media-text.en.json": media_text_fields,
        "content/en/writer-submission.json": writer_submission_fields,
    }
    results = []
    for relative, collector in collectors.items():
        document = json.load(open(require_file(relative), encoding="utf-8"))
        public_fields = list(collector(document))
        public_paths = {path for path, _text in public_fields}
        all_fields = list(walk_strings(document, ""))
        missing = sorted(public_paths.difference(path for path, _text in all_fields))
        if missing:
            raise RuntimeError(f"{relative} public paths absent from walker: {missing}")
        other_fields = [(path, text) for path, text in all_fields if path not in public_paths]
        public_result = scan_field_group(public_fields, token, canary_id)
        other_result = scan_field_group(other_fields, token, canary_id)
        item = {
            "path": relative,
            "publicText": public_result,
            "otherStrings": other_result,
        }
        if relative == "content/en/public-references.en.json":
            item["quotes"] = quote_occurrence_histogram(document)
        results.append(item)
    return results


def scan_svgs(token, canary_id):
    results = []
    for relative in SVG_SCAN_PATHS:
        absolute = require_file(relative)
        source = open(absolute, encoding="utf-8").read()
        visible = svg_visible_text(absolute)
        if not visible:
            raise RuntimeError(f"SVG visible text elements absent: {absolute}")
        visible_text = "\n".join(visible)
        results.append(
            {
                "path": relative,
                "visibleTextElementCount": len(visible),
                "visibleTokenHits": count_exact(visible_text, token),
                "visibleIdHits": count_exact(visible_text, canary_id),
                "sourceTokenHits": count_exact(source, token),
                "sourceIdHits": count_exact(source, canary_id),
            }
        )
    return results


def scan_rasters(token, canary_id):
    token_bytes = token.encode("utf-8")
    id_bytes = canary_id.encode("utf-8")
    results = []
    for relative in RASTER_SCAN_PATHS:
        absolute = require_file(relative)
        if relative.endswith(".webp"):
            parsed = parse_webp(absolute)
            metadata = b""
            bitmap = b""
            for chunk_id, payload in parsed["chunks"]:
                if chunk_id in BITMAP_CHUNK_IDS:
                    bitmap += payload
                else:
                    metadata += payload
            item = {
                "path": relative,
                "container": parsed["container"],
                "byteLength": parsed["byteLength"],
                "sha256": sha256_bytes(parsed["data"]),
                "fourccs": parsed["fourccs"],
                "vp8LossyPresent": parsed["vp8LossyPresent"],
                "vp8lLosslessPresent": parsed["vp8lLosslessPresent"],
                "vp8xPresent": parsed["vp8xPresent"],
                "dimensions": parsed["dimensions"],
                "wholeFileTokenHits": byte_hits(parsed["data"], token_bytes),
                "wholeFileIdHits": byte_hits(parsed["data"], id_bytes),
                "nonBitmapChunkTokenHits": byte_hits(metadata, token_bytes),
                "nonBitmapChunkIdHits": byte_hits(metadata, id_bytes),
                "bitmapChunkTokenHits": byte_hits(bitmap, token_bytes),
                "bitmapChunkIdHits": byte_hits(bitmap, id_bytes),
                "check": "byte-layer exact search; fourcc VP8 is lossy VP8, not VP8L; not pixel OCR",
            }
        elif relative.endswith(".avif"):
            parsed = parse_avif(absolute)
            metadata = b""
            mdat = b""
            for box in parsed["boxIndex"]:
                if box["depth"] != 0:
                    continue
                payload = parsed["data"][box["payloadStart"] : box["payloadEnd"]]
                if box["type"] == b"mdat":
                    mdat += payload
                else:
                    metadata += payload
            item = {
                "path": relative,
                "container": parsed["container"],
                "byteLength": parsed["byteLength"],
                "sha256": sha256_bytes(parsed["data"]),
                "majorBrand": parsed["majorBrand"],
                "topBoxes": [box["type"] for box in parsed["boxes"] if box["depth"] == 0],
                "dimensions": parsed["dimensions"],
                "wholeFileTokenHits": byte_hits(parsed["data"], token_bytes),
                "wholeFileIdHits": byte_hits(parsed["data"], id_bytes),
                "nonMdatTokenHits": byte_hits(metadata, token_bytes),
                "nonMdatIdHits": byte_hits(metadata, id_bytes),
                "mdatTokenHits": byte_hits(mdat, token_bytes),
                "mdatIdHits": byte_hits(mdat, id_bytes),
                "check": "byte-layer exact search of ftyp/meta versus mdat; not pixel OCR",
            }
        else:
            raise RuntimeError(f"unsupported raster suffix: {absolute}")
        results.append(item)
    return results


def scan_draft(token, canary_id):
    absolute = require_file(TEXT_SCAN_PATH)
    text = open(absolute, encoding="utf-8").read()
    return {
        "path": TEXT_SCAN_PATH,
        "characters": len(text),
        "tokenHits": count_exact(text, token),
        "idHits": count_exact(text, canary_id),
    }


def assert_report_has_no_secret(report, token):
    if token in report:
        raise RuntimeError("scan report contained the secret marker and was suppressed")


def main():
    buffer = io.StringIO()
    real_stdout = sys.stdout
    sys.stdout = buffer
    try:
        run_scan()
    finally:
        sys.stdout = real_stdout
    report = buffer.getvalue()
    identity = json.load(
        open(os.path.join(OPS, "control/canary-identity.json"), encoding="utf-8")
    )
    assert_report_has_no_secret(report, identity["canarySecretToken"])
    sys.stdout.write(report)


def run_scan():
    started = clock_now()
    print(f"scanAsOf={started}")
    identity_path, identity = load_identity()
    token = identity["canarySecretToken"]
    canary_id = identity["canaryId"]
    identity_hash = sha256_file(identity_path)
    token_hash = sha256_bytes(token.encode("utf-8"))
    stored_hash = identity.get("sha256")
    print("[identity]")
    print(f"path=control/canary-identity.json")
    print(f"fields={sorted(identity)}")
    print(f"canaryId={canary_id}")
    print(f"tokenLength={len(token)}")
    print(f"tokenSha256={token_hash}")
    print(f"tokenSha256Match={str(token_hash == EXPECTED_TOKEN_SHA256).lower()}")
    print(f"identitySha256={identity_hash}")
    print(f"identitySha256Match={str(identity_hash == EXPECTED_IDENTITY_SHA256).lower()}")
    print(f"storedSha256FieldMatch={str(stored_hash == token_hash).lower()}")
    print_hash_comparisons()
    print_permission_observations()
    print_archive_stat()
    draft_result = scan_draft(token, canary_id)
    json_results = scan_json_documents(token, canary_id)
    svg_results = scan_svgs(token, canary_id)
    raster_results = scan_rasters(token, canary_id)
    counter_result = run_counter(require_file(TEXT_SCAN_PATH))
    removed_captions = write_caption_excluded_copy(require_file(TEXT_SCAN_PATH))
    caption_result = run_counter(CAPTION_COPY)
    print("[draft text scan]")
    print(json.dumps(draft_result, ensure_ascii=False))
    print("[json field scan]")
    print(json.dumps(json_results, ensure_ascii=False, indent=2))
    print("[svg scan]")
    print(json.dumps(svg_results, ensure_ascii=False, indent=2))
    print("[raster byte-layer scan]")
    printable_rasters = []
    for item in raster_results:
        printable = dict(item)
        printable_rasters.append(printable)
    print(json.dumps(printable_rasters, ensure_ascii=False, indent=2))
    print("[length counter]")
    print(f"removedSchematicLines={removed_captions}")
    print("FULL " + json.dumps(counter_result, ensure_ascii=False))
    print("CAPTION_EXCLUDED " + json.dumps(caption_result, ensure_ascii=False))
    print("[not scanned]")
    for item in NOT_SCANNED:
        print(item)
    print(f"scanFinishedAt={clock_now()}")
    print("zeroMatchMeaning=exact string absence in the listed fields only")
    print("qualityGateSigned=false")


if __name__ == "__main__":
    try:
        main()
    except Exception as error:
        message = str(error)
        identity_path = os.path.join(OPS, "control/canary-identity.json")
        if os.path.isfile(identity_path):
            secret = json.load(open(identity_path, encoding="utf-8")).get("canarySecretToken", "")
            if secret and secret in message:
                message = "exception contained the secret marker and was suppressed"
        print(f"SCAN_FAILED {type(error).__name__}: {message}", file=sys.stderr)
        raise SystemExit(1) from None

