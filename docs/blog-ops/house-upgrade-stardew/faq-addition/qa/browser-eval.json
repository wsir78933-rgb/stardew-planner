    "desktop_zh": {
      "viewName": "Desktop Chinese",
      "url": "http://127.0.0.1:3010/zh/house-upgrade-stardew",
      "title": "星露谷房屋升级：第二档是65,000金和100硬木",
      "viewport": {
        "width": 1280,
        "height": 800,
        "deviceScaleFactor": 1,
        "mobile": false
      },
      "h2": "星露谷房屋升级常见问题",
      "initialItemsCount": 6,
      "initialTriggersCount": 6,
      "initialAnswersCount": 6,
      "items": [
        {
          "index": 0,
          "question": "每一档农舍升级要多少金币和材料？",
          "answer": "第一次升级是10,000金和450木材。第二次是65,000金和100硬木，这是1.6的价格。第三次是100,000金。"
        },
        {
          "index": 1,
          "question": "每次升级要多久？",
          "answer": "每次升级都要三天。"
        },
        {
          "index": 2,
          "question": "第二次升级的硬木怎么获得？罗宾出售硬木吗？",
          "answer": "罗宾的普通存货不出售硬木。秘密森林里六棵大树桩每天重新长出。入口那根圆木要用钢斧头清除。"
        },
        {
          "index": 3,
          "question": "哪一档升级解锁地窖？",
          "answer": "第三次升级在房子下面加上地窖。从厨房进去。地窖一开始有33个木桶。"
        },
        {
          "index": 4,
          "question": "升级会增加室外占地吗？",
          "answer": "室外占地保持9×5，所以房子旁边的地块还是原来那样。第三次升级后，房子外面和上一次升级时一样。"
        },
        {
          "index": 5,
          "question": "装修和升级有什么区别？",
          "answer": "每次升级都要三天。第二次升级之后可以做装修，而且马上完成。例如移除婴儿床，或增加餐厅这间房间。"
        }
      ],
