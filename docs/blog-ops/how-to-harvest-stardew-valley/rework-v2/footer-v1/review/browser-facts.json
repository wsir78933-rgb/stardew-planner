          "initialClosed": true,
          "answers": [
            {
              "index": 0,
              "state": "open",
              "question": "How do you harvest a regular mature crop by hand on PC?",
              "answerText": "Stand beside the ripe crop and right-click it, or press X. X is mapped to the same Check/Do Action as right-click. A hand harvest does not need a tool swing.",
              "answerHeight": 71,
              "triggerWidth": 704,
              "triggerHeight": 58
            },
            {
              "index": 1,
              "state": "open",
              "question": "Which crops need a regular scythe, and how is the 1.6 iridium scythe different?",
              "answerText": "Amaranth, kale, wheat, unmilled rice, and fiber seeds need a scythe. Right-click or X does not harvest them. The iridium scythe is the 1.6 Farming Mastery scythe, and within its swing it harvests crops grown on tilled soil, including regular crops.",
              "answerHeight": 80,
              "triggerWidth": 704,
              "triggerHeight": 58
            },
            {
              "index": 2,
              "state": "open",
              "question": "How do you harvest a giant crop?",
              "answerText": "Use any axe. Face the giant crop and strike it three times with the tool button (left-click or C on PC).",
              "answerHeight": 46,
              "triggerWidth": 704,
              "triggerHeight": 58
            },
            {
              "index": 3,
              "state": "open",
              "question": "Does a missed watering day delay the harvest?",
              "answerText": "An unwatered day pauses growth and does not kill the crop, so maturity is one morning later for each dry day. Fiber seeds do not need daily watering to grow, but they still need a scythe when fully grown.",
              "answerHeight": 98,
              "triggerWidth": 704,
              "triggerHeight": 58
            },
            {
              "index": 4,
              "state": "open",
              "question": "Why do trellis crops need a neighboring standing tile?",
              "answerText": "You cannot walk through a living trellis, so green bean, hops, and grape each need a neighboring tile you can stand on. A solid block leaves the interior plants unreachable.",
              "answerHeight": 71,
              "triggerWidth": 704,
              "triggerHeight": 58
            }
          ],
          "sourcesShot": "screenshots/en-1440-sources.png"
        },
